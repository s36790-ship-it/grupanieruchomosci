{
  // Cloudflare Workers: statyczna strona Astro (dist/) + mały Worker na formularz (worker/index.ts).
  // Deploy: Workers Builds z GitHuba (build: npm run build, deploy: npx wrangler deploy) — patrz docs/WDROZENIE.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grupanieruchomosci",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker uruchamia się przy każdym żądaniu: przekierowuje www/http na adres kanoniczny (301),
    // obsługuje /api/*, a resztę oddaje z plików statycznych. Darmowy plan: 100 tys. żądań dziennie.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "vars": {
    "FORMULARZ_ODBIORCA": "t.brynkiewicz@gmail.com",
    "FORMULARZ_NADAWCA": "Grupa Nieruchomości <formularz@xn--grupa-nieruchomoci-mod.pl>",
    "DOZWOLONE_ORIGINY": "https://xn--grupa-nieruchomoci-mod.pl,https://www.xn--grupa-nieruchomoci-mod.pl"
  }
  // RESEND_API_KEY ustawiamy jako Secret w panelu Cloudflare (albo: npx wrangler secret put RESEND_API_KEY).
  // Nigdy nie wpisujemy go do tego pliku ani do repozytorium.
}
